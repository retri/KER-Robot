  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "language": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "ko-KR",
              "en-US"
            ]
          }
        },
        "required": [
          "language"
        ],
        "additionalProperties": false
      },
      "profile": {
        "type": "object",
        "properties": {
          "nickname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "preferred_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "required": [
          "nickname",
          "preferred_name"
        ],
        "additionalProperties": false
      },
      "purpose": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string",
            "enum": [
              "companion",
              "education",
              "care",
              "home"
            ]
          }
        },
        "required": [
          "purpose"
        ],
        "additionalProperties": false
      },
      "preferences": {
        "type": "object",
        "properties": {
          "voice_id": {
            "type": "string",
            "enum": [
              "device_default",
              "demo_voice_a"
            ]
          },
          "speech_rate": {
            "type": "number",
            "minimum": 0.7,
            "maximum": 1.3
          },
          "volume": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "expression_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "gesture_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        },
        "required": [
          "voice_id",
          "speech_rate",
          "volume",
          "expression_level",
          "gesture_level"
        ],
        "additionalProperties": false
      },
      "consent": {
        "type": "object",
        "properties": {
          "long_term_memory": {
            "type": "boolean"
          },
          "conversation_storage": {
            "type": "boolean"
          },
          "biometric_identity": {
            "type": "boolean"
          },
          "cloud_transfer": {
            "type": "boolean"
          }
        },
        "required": [
          "long_term_memory",
          "conversation_storage",
          "biometric_identity",
          "cloud_transfer"
        ],
        "additionalProperties": false
      },
      "review": {
        "type": "object",
        "properties": {
          "confirmed": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "confirmed"
        ],
        "additionalProperties": false
      },
      "Session": {
        "type": "object",
        "required": [
          "session_id",
          "actor_id",
          "device_id",
          "status",
          "revision",
          "expires_at",
          "draft",
          "profile_id"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "actor_id": {
            "type": "string"
          },
          "device_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "in_progress",
              "committed",
              "cancelled",
              "expired"
            ]
          },
          "revision": {
            "type": "integer"
          },
          "expires_at": {
            "type": "number"
          },
          "draft": {
            "type": "object",
            "properties": {
              "language": {
                "$ref": "#/components/schemas/language"
              },
              "profile": {
                "$ref": "#/components/schemas/profile"
              },
              "purpose": {
                "$ref": "#/components/schemas/purpose"
              },
              "preferences": {
                "$ref": "#/components/schemas/preferences"
              },
              "consent": {
                "$ref": "#/components/schemas/consent"
              },
              "review": {
                "$ref": "#/components/schemas/review"
              }
            },
            "additionalProperties": false
          },
          "profile_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Completion": {
        "type": "object",
        "required": [
          "session_id",
          "profile_id",
          "registration_status",
          "apply_status",
          "hardware_connected",
          "revision"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "profile_id": {
            "type": "string",
            "format": "uuid"
          },
          "registration_status": {
            "type": "string",
            "const": "committed"
          },
          "apply_status": {
            "type": "string",
            "const": "pending"
          },
          "hardware_connected": {
            "type": "boolean",
            "const": false
          },
          "revision": {
            "type": "integer"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error_code"
        ],
        "properties": {
          "error_code": {
            "type": "string"
          }
        }
      }
    }
  }
