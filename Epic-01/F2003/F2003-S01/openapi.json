  "components": {
    "securitySchemes": {
      "devToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Maps to server-bound synthetic actor/profile/device; not production identity"
      }
    },
    "schemas": {
      "MemoryCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "topic",
          "content",
          "source_ref",
          "confidence",
          "ttl_seconds"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "preference",
              "fact",
              "promise"
            ]
          },
          "topic": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "source_ref": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "ttl_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 31536000
          }
        }
      }
    }
  }
